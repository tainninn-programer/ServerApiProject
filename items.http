# ===== 引数（ここを書き換えてから、下の各リクエストを送る） =====
@host = http://localhost:5224

# 1件取得
@getId = 1

# 追加
@postName = melon

# 名前の変更
@patchId = 1
@patchName = orange

# 削除
@deleteId = 1

# ===== リクエスト =====

### 一覧
GET {{host}}/items

### 1件取得
GET {{host}}/items/{{getId}}

### 追加
POST {{host}}/items
Content-Type: application/json

{"name": "{{postName}}"}

### 名前の変更
PATCH {{host}}/items/{{patchId}}
Content-Type: application/json

{"name": "{{patchName}}"}

### 削除
DELETE {{host}}/items/{{deleteId}}

# ===== 異常系（値は固定） =====

### 存在しないid → 404
GET {{host}}/items/999

### 数字でないid
GET {{host}}/items/abc

### 空の名前で追加
POST {{host}}/items
Content-Type: application/json

{"name": ""}
